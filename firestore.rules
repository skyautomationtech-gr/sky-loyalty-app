rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getStaffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "skyautomationtech@gmail.com" ||
        (exists(/databases/$(database)/documents/staff/$(request.auth.token.email)) && getStaffData().role == 'Master Admin')
      );
    }

    function isAdmin() {
      return isMasterAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email)) && 
        (getStaffData().role == 'Admin' || getStaffData().role == 'Master Admin')
      );
    }

    function isStaff() {
      return isAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email)) && 
        (getStaffData().role == 'Staff' || getStaffData().role == 'Admin' || getStaffData().role == 'Master Admin')
      );
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /customers/{customerId} {
      // Allow public read for the Customer Portal search
      allow read: if isStaff() || !isAuthenticated();
      allow create, update: if isStaff();
      allow delete: if isMasterAdmin();
    }

    match /staff/{staffId} {
      // Allow read (both get and list) for anyone to facilitate login/migration queries
      allow read: if true;
      allow create, delete: if isMasterAdmin();
      allow update: if isMasterAdmin() || (
        isAuthenticated() && 
        (resource.data.email == request.auth.token.email || staffId == request.auth.token.email)
      );
    }

    match /branches/{branchId} {
      allow read: if isStaff();
      allow create, update, delete: if isMasterAdmin();
    }

    match /rewards/{rewardId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isMasterAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isMasterAdmin();
    }

    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read: if isMasterAdmin();
      allow create: if isAuthenticated();
      allow delete: if isMasterAdmin();
    }
  }
}
